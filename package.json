{
  "name": "extensao-ia-local",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "description": "Assistente de escrita com IA local para WhatsApp Web.",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:step06:browser": "node tests/browser/step06-proof.mjs",
    "test:step07:browser": "node tests/browser/step07-correction.mjs",
    "test:step08:browser": "node tests/browser/step08-preservation.mjs",
    "test:step09:browser": "node tests/browser/step09-actions.mjs",
    "test:step10:browser": "node tests/browser/step10-streaming.mjs",
    "test:step11:browser": "node tests/browser/step11-evaluation.mjs && node tests/browser/step11-flow.mjs",
    "test:step12:browser": "node tests/browser/step12-profiles.mjs",
    "test:step12:switch": "node tests/browser/step12-switch.mjs",
    "test:step13:browser": "node tests/browser/step13-cache.mjs",
    "test:step14:browser": "node tests/browser/step14-settings.mjs",
    "test:step14:model": "node tests/browser/step14-model.mjs",
    "benchmark:step15": "node --experimental-strip-types tests/browser/step15-benchmark.mjs",
    "benchmark:step15a:report": "node --experimental-strip-types tests/browser/step15a-report.mjs",
    "benchmark:step15:report": "node --experimental-strip-types tests/browser/step15-report.mjs",
    "benchmark:step15:controls": "node tests/browser/step15-controls.mjs",
    "test:step15:browser": "node tests/browser/step15-smoke.mjs",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "package": "npm run build && node build/package.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:step15b:browser": "node tests/browser/step15b-native.mjs",
    "test:step15b:portuguese": "node tests/browser/step15b-portuguese.mjs",
    "test:step15b:specialized": "node tests/browser/step15b-specialized.mjs",
    "test:step15c:browser": "node tests/browser/step15c-gemma.mjs",
    "test:step15c:controls": "node tests/browser/step15c-controls.mjs",
    "test:step15c:cache": "node tests/browser/step15c-cache.mjs",
    "benchmark:step15d": "node --experimental-strip-types tests/browser/step15d-benchmark.mjs",
    "benchmark:step15d:report": "node --experimental-strip-types tests/browser/step15d-report.mjs",
    "test:step15e:browser": "node tests/browser/step15e-manual-review.mjs",
    "test:step15f:browser": "node tests/browser/step15f-interface.mjs",
    "test:step15f:popup": "node tests/browser/step15f-popup.mjs",
    "test:step15g:browser": "node tests/browser/step15g-language.mjs",
    "test:step15h:browser": "node tests/browser/step15h-direct.mjs",
    "test:step16:browser": "node tests/browser/step16-release.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mlc-ai/web-llm": "0.2.82",
    "@mlc-ai/web-tokenizers": "0.1.6",
    "@noble/hashes": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.0",
    "@types/dom-chromium-ai": "0.0.17",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "0.1.69",
    "adm-zip": "0.6.1",
    "eslint": "10.11.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.55.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.4"
  }
}
