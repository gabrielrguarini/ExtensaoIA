{
  "manifest_version": 3,
  "name": "IA local — WhatsApp Web",
  "version": "0.16.1",
  "description": "Corrija e reescreva rascunhos com IA local. Substituição direta ou prévia, conforme suas configurações. Sem envio automático.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "offscreen", "sidePanel"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://huggingface.co/*",
    "https://us.aws.cdn.hf.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "IA local · Configurações",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; connect-src 'self' https://huggingface.co https://us.aws.cdn.hf.co; base-uri 'none'; frame-ancestors 'none'"
  }
}
